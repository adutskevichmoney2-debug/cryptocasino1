# ── Supabase ────────────────────────────────────────────────────────────────
# Project Settings → API. Without these the app falls back to the local
# mock data layer and still runs.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses row level security — never expose it to the browser
# and never prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ── Site ────────────────────────────────────────────────────────────────────
# Used for auth redirect URLs and referral links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
